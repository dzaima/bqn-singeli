local {
  include 'skin/c'
  include 'util/tup'
  include './basic'
  oper ~~ reinterpret infix right 55
  def num{x} = 'number'==kind{x}
  def all{t} = is{t, 0 <= t}
  def any = fold{|,.}

  def ew{V} = width{eltype{V}}
  def va{V} = hasarch{'SIMD128'} and 'vector'==typekind{V} and 128==width{V}
  def vi{V} = va{V} and isint{eltype{V}}
  def vs{V} = va{V} and any{tup{'i','f'}==quality{eltype{V}}}
  def vu{V} = va{V} and 'u'==quality{eltype{V}}
  def vf{V} = va{V} and isfloat{eltype{V}}
  def hw{[_]E, ...ws} = any{ws == width{E}}
  def nw{...args} = not hw{...args}

  def change_qual{[k]T,q} = [k]primtype{q, width{T}}
  def uns = change_qual{.,'u'}
  def sgn = change_qual{.,'i'}
  def int_idx{inds, max} = (((inds>>0) == inds) & (inds >= 0)) & (inds < max)

  def prim_dbl{E}  = primtype{quality{E}, width{E}*2}
  def prim_half{E} = primtype{quality{E}, width{E}/2}
  def el_dbl{[k]E} = [k/2]prim_dbl{E}
  def el_half{[k]E} = [k*2]prim_half{E}

  def fmttype{128} = 'v128'
  def fmttype{[k]E} = merge{quality{E}, fmtnat{width{E}}, 'x', fmtnat{k}}
  def intrin{...rest, V} = merge{'wasm_', fmttype{V}, '_', ...rest}
}

local {
  include 'util/kind'
  def swizzle_i8{a:V, s} = emit{V, intrin{'swizzle', [16]i8}, a, s}
  def check_spec_i8{spec, val:V=[_]E, shuf} = {
    match (...spec) {
      {} => width{E}==8
      {(if (shuf) 16 else 8)} => 1
      {V=[_]_ if shuf and hw{V,8}} => 1
      {T} => ktyp{T} and width{T}==8
    }
  }
  
  def nspc # no spec placeholder
  
  def {try_const_shuf, try_const_sel}
  def try_const_shuf{spec, v, inds} = 0#not is{0,tonums{inds}}
  
  def anyeq{v, ...options} = any{each{is{v,.}, options}}
  
  def same_type{_} = 0
  def same_type{{h:V, ...t} if all{each{hastype{.,V}, t}}} = V
  
  def tonums{_} = 0
  def tonums{{...vs}   if length{vs}>0 and all{each{num, vs}}} = vs
  def tonums{{{...vs}} if length{vs}>0 and all{each{num, vs}}} = vs
  
  def try_const_sel{..._} = 0
  def try_const_sel{spec, vs, inds if not is{0,tonums{inds}} and anyeq{length{vs}, 1,2}} = {
    def inds = tonums{inds}
    def vn = length{vs}
    def V = same_type{vs}
    if (va{V}) {
      def e = match (spec) {
        {(nspc)} => ew{V}
        {k if num{k} and anyeq{k, 8,16,32,64}} => k
        {T if ktyp{T} and typekind{T}=='primitive'} => width{T}
        {_} => 0
      }
      if (e != 0 and width{V}/e == length{inds}) {
        def max = vn*width{V} / e
        if (all{(((inds>>0) == inds) & (inds >= 0)) & (inds < max)}) {
          {} => emit{V, intrin{'shuffle', [width{V}/e]primtype{'i',e}}, ...select{vs, tup{0,-1}}, ...inds}
        } else 0
      } else 0
    } else 0
  }
  
  def shufsel{is_shuf} = {
    def try_const = if (is_shuf) try_const_shuf else try_const_sel
    def has_const{...a} = not is{try_const{...a}, 0}
    
    def me{...spec, val:V=[_]_,                  ind:I if vi{I} and hw{I,8} and check_spec_i8{spec, val, is_shuf}} = swizzle_i8{val, ind}
    def me{...spec, {val:V=[_]_} if not is_shuf, ind:I if vi{I} and hw{I,8} and check_spec_i8{spec, val, is_shuf}} = swizzle_i8{val, ind}
    
    def wrap = match { {{...t}} => t; {v} => tup{v} }
    def me{      v, ...ind if has_const{nspc, wrap{v}, ind}} = try_const{nspc, wrap{v}, ind}{}
    def me{spec, v, ...ind if has_const{spec, wrap{v}, ind}} = try_const{spec, wrap{v}, ind}{}
  }
}

def vec_shuffle{...} = shufsel{1}
def vec_select{...} = shufsel{0}



local def wasm_blend{hom}{f:V=[k]_, t:V, m:M=[k]_ if va{V} and vi{M}} = {
  def i = if (hom and hasarch{'RELAXED_SIMD'}) intrin{'relaxed_laneselect', sgn{V}}
  else intrin{'bitselect', 128}
  emit{V, i, t, f, m}
}
def blend_bit{...} = wasm_blend{0}
def blend_hom{...} = wasm_blend{1}



local def same_el{vs} = match (same_type{vs}) { {[_]E}=>E; {_}=>0 }
local def narrow_am{D,S,default} = if (not is{S,0} and quality{D}==quality{S}) width{S}/width{D} else default
local def narrows{D,S} = narrow_am{D,S,0}>=2

local def some_narrow{kind} = { 
  def {do_trunc, do_sat} = match (kind) {
    {'trunc'}   => tup{1,0}
    {'relaxed'} => tup{1,0}
    {'sat'}     => tup{0,1}
  }
  def extend _{n, ntup} = {
    def ntup{E, {...vs} if is{same_el{vs},E}} = vs

    def ntup{DE, {...vs={_:[_]E,..._} if length{vs}>2} if narrows{DE,same_el{vs}}} = {
      def ntup = prim_half{E}
      ntup{DE, join{each{ntup{ntup,.}, split{2, vs}}}}
    }

    def ntup{DE if isint{DE}, {a:V=[_]E, b:V} if do_trunc and narrows{DE,E}} = {
      def MV = el_half{V}
      if (width{E}==64) ntup{DE, tup{MV~~vec_select{u32, tup{a,b}, range{4}*2}}}
      else ntup{DE, tup{emit{MV, intrin{'narrow_', fmttype{sgn{V}}, MV}, a, b}}}
    }
    def ntup{DE, {a:V=[_]E} if do_trunc and narrows{DE,E}} = ntup{DE, tup{a,vec_broadcast{V,0}}}
    def ntup{DE if isint{DE}, {...vs={_:[k]_,..._} if length{vs}<=2} if do_trunc and narrow_am{DE,same_el{vs},0}>=4} = {
      tup{vec_select{DE, vs, cycle{128/width{DE}, range{length{vs}*k}*2}}}
    }

    def n{DE, v:V=[_]E if va{V} and narrow_am{DE,E,0}>=1} = select{ntup{DE, tup{v}}, 0}
  }
}

extend (some_narrow{'trunc'  }){narrow_trunc,   narrow_tup_trunc}
extend (some_narrow{'relaxed'}){narrow_relaxed, narrow_tup_relaxed}

def vec_merge_shift_left_128 {x:V=[k]_, y:V, n if va{V}} = vec_select{tup{x,y}, range{k}+n}
def vec_merge_shift_right_128{x:V=[k]_, y:V, n if va{V}} = vec_select{tup{x,y}, range{k}+k-n}
def vec_shift_left_128 {x:V, n if va{V}} = vec_merge_shift_left_128 {x, vec_broadcast{V,0}, n}
def vec_shift_right_128{x:V, n if va{V}} = vec_merge_shift_right_128{vec_broadcast{V,0}, x, n}

def vec_shift_left {...} = vec_shift_left_128
def vec_shift_right{...} = vec_shift_right_128
def vec_merge_shift_left {...} = vec_merge_shift_left_128
def vec_merge_shift_right{...} = vec_merge_shift_right_128

def unzip128{a:V=[k]_, b:V, i if va{V} and int_idx{i,2}} = vec_select{tup{a,b}, range{k}*2 + i}
def   zip128{a:V=[k]_, b:V, i if va{V} and int_idx{i,2}} = vec_select{tup{a,b}, flat_table{+, range{k/2}, tup{0,k}} + i*k/2}

def unzip{a:V, b:V, i if va{V}} = unzip128{a,b,i}
def   zip{a:V, b:V, i if va{V}} =   zip128{a,b,i}

def reverse_units{n, x:[l]_ if knum{n} and n>1 and l%n == 0} = {
  vec_shuffle{x, n-1 - range{n}}
}
def blend_units{f:V=[k]_, t:V, ...m if all{int_idx{m,2}} and k%length{m}==0} = blend_units{f, t, m}
def blend_units{f:V=[k]_, t:V,    m if all{int_idx{m,2}} and k%length{m}==0} = blend_hom{f, t, -vec_make{uns{V}, cycle{k,m}}}
